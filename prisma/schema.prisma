generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CASHIER
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentMethod {
  CASH
  QRIS
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]

  @@index([role])
  @@map("users")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@map("categories")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  phone     String?  @unique
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  categoryId  String           @db.Uuid
  name        String
  basePrice   Decimal          @db.Decimal(12, 2)
  isAvailable Boolean          @default(true)
  imageUrl    String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variants    ProductVariant[]
  modifiers   Modifier[]
  recipes     Recipe[]
  orderItems  OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([deletedAt])
  @@unique([categoryId, name])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @db.Uuid
  name       String
  priceDelta Decimal  @default(0) @db.Decimal(12, 2)

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipe     Recipe?
  orderItems OrderItem[]

  @@index([productId])
  @@unique([productId, name])
  @@map("product_variants")
}

model Modifier {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @db.Uuid
  name               String
  price              Decimal             @default(0) @db.Decimal(12, 2)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@index([productId])
  @@unique([productId, name])
  @@map("modifiers")
}

model Ingredient {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @unique
  unit           String
  currentStock   Decimal         @db.Decimal(12, 3)
  minimumStock   Decimal         @db.Decimal(12, 3)
  costPerUnit    Decimal         @db.Decimal(12, 2)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  recipeItems    RecipeItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@map("ingredients")
}

model Recipe {
  id         String       @id @default(uuid()) @db.Uuid
  productId  String       @db.Uuid
  variantId  String?      @unique @db.Uuid
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipeItems RecipeItem[]

  @@index([productId])
  @@map("recipes")
}

model RecipeItem {
  id           String      @id @default(uuid()) @db.Uuid
  recipeId     String      @db.Uuid
  ingredientId String      @db.Uuid
  qtyUsed      Decimal     @db.Decimal(12, 3)

  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ingredient   Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([recipeId])
  @@index([ingredientId])
  @@unique([recipeId, ingredientId])
  @@map("recipe_items")
}

model Order {
  id                  String               @id @default(uuid()) @db.Uuid
  invoiceNumber       String               @unique
  cashierId           String               @db.Uuid
  customerId          String?              @db.Uuid
  customerNameSnapshot String?
  status              OrderStatus          @default(DRAFT)
  paymentStatus       PaymentStatus        @default(PENDING)
  subtotal            Decimal              @db.Decimal(12, 2)
  taxAmount           Decimal              @default(0) @db.Decimal(12, 2)
  serviceAmount       Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal              @db.Decimal(12, 2)
  receiptToken        String?              @unique
  paidAt              DateTime?
  stockDeductedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  cashier             User                 @relation(fields: [cashierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  orderItems          OrderItem[]
  paymentTransactions PaymentTransaction[]
  receiptAccessLogs   ReceiptAccessLog[]

  @@index([cashierId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String              @id @default(uuid()) @db.Uuid
  orderId             String              @db.Uuid
  productId           String              @db.Uuid
  variantId           String?             @db.Uuid
  productNameSnapshot String
  variantNameSnapshot String?
  unitPrice           Decimal             @db.Decimal(12, 2)
  qty                 Int
  notes               String?
  lineTotal           Decimal             @db.Decimal(12, 2)

  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product             Product             @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  variant             ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  modifiers           OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderItemModifier {
  id                   String     @id @default(uuid()) @db.Uuid
  orderItemId          String     @db.Uuid
  modifierId           String     @db.Uuid
  modifierNameSnapshot String
  price                Decimal    @db.Decimal(12, 2)

  orderItem            OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  modifier             Modifier   @relation(fields: [modifierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderItemId])
  @@index([modifierId])
  @@map("order_item_modifiers")
}

model PaymentTransaction {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(12, 2)
  grossAmount      Decimal?      @db.Decimal(12, 2)
  amountReceived   Decimal?      @db.Decimal(12, 2)
  changeAmount     Decimal?      @db.Decimal(12, 2)
  gatewayProvider  String?
  gatewayReference String?
  transactionId    String?
  midtransOrderId  String?
  snapToken        String?
  redirectUrl      String?
  qrString         String?
  expiredAt        DateTime?
  paidAt           DateTime?
  rawResponse      Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  order            Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@index([method])
  @@index([status])
  @@index([gatewayReference])
  @@index([transactionId])
  @@index([midtransOrderId])
  @@map("payment_transactions")
}

model StockMovement {
  id           String            @id @default(uuid()) @db.Uuid
  ingredientId String            @db.Uuid
  type         StockMovementType
  qty          Decimal           @db.Decimal(12, 3)
  note         String?
  referenceId  String?
  createdAt    DateTime          @default(now())

  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ingredientId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

model ReceiptAccessLog {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @db.Uuid
  accessedAt DateTime  @default(now())
  userAgent  String?

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@index([accessedAt])
  @@map("receipt_access_logs")
}
